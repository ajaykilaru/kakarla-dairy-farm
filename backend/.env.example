# Local development defaults. Never commit your real .env file.
NODE_ENV=development
PORT=3000
# Generate a long random secret (at least 32 characters) for JWT signing.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_dairy

# Set DB_SSL=true for hosted MySQL providers that require TLS.
DB_SSL=false
# If your provider supplies a CA certificate, paste its PEM contents here.
# For multiline environment variables, preserve newlines or use \\n escapes.
DB_SSL_CA=

# Optional Telegram notification integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional customer password-reset SMS gateway; accepts JSON { "to": "phone", "message": "..." }.
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# Initial Super Admin bootstrap only (npm run create-admin)
ADMIN_NAME=MilkMate Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_at_least_12_characters

# Optional: set only when frontend and API are hosted on different origins. Example: https://api.example.com
# VITE_API_BASE_URL=
# Optional Vite dev proxy target; default is http://127.0.0.1:3000
# MILKMATE_API_TARGET=http://127.0.0.1:3000
