{
  "name": "Kakarla Dairy Farm",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [3000, 5173],
  "portsAttributes": {
    "3000": {
      "label": "Dairy Farm API",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "Dairy Farm App",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "bash -lc 'if ! pgrep -f \"[n]pm run dev\" >/dev/null; then nohup npm run dev > /tmp/kakarla-dairy-farm.log 2>&1 </dev/null & fi'"
}
